{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.{ts,tsx}"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "includes": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.{ts,tsx}"],
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useSortedClasses": "warn"
      },
      "style": {
        "noJsxLiterals": {
          "level": "warn",
          "options": {
            "noStrings": false,
            "ignoreProps": true,
            "allowedStrings": [
              "·",
              "•",
              "×",
              "→",
              "/",
              "|",
              "?",
              "*",
              "(",
              ")",
              "%"
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/client/**/*.{ts,tsx}", "!src/client/lib/env.ts"],
      "plugins": ["./biome-plugins/no-bun-public-env.grit"]
    },
    {
      "includes": ["src/client/**/*.{ts,tsx}"],
      "plugins": [
        "./biome-plugins/no-dynamic-i18n-key.grit",
        "./biome-plugins/no-t-rename.grit",
        "./biome-plugins/always-render-modal.grit"
      ]
    },
    {
      "includes": ["src/api/**/*.ts"],
      "plugins": ["./biome-plugins/no-dynamic-translate-key.grit"]
    },
    {
      "includes": ["src/modules/**/*.ts", "tests/lint/.probe-*/**/*.ts"],
      "plugins": ["./biome-plugins/require-resolution-hooks.grit"]
    },
    {
      "includes": ["src/client/pages/*.tsx"],
      "plugins": ["./biome-plugins/require-page-container.grit"]
    },
    // The two test rules below (tooling/process/agents-ship/testes.md, T5 and T6) carry the files that
    // predate them as negated entries. The list only shrinks: a file leaves it when it is cleaned up,
    // and a new file never enters it.
    {
      "includes": [
        "tests/**/*.{ts,tsx}",
        "!tests/tooling/**",
        "!tests/scripts/**",
        "!tests/api/error-catalog.test.ts",
        "!tests/api/lib/refusal-callsites.test.ts",
        "!tests/api/lib/schema-refusal-production.test.ts",
        "!tests/api/lib/step-up.test.ts",
        "!tests/api/v1/agent-config-health.test.ts",
        "!tests/api/v1/code-tools-controller.test.ts",
        "!tests/api/v1/document-id-range.test.ts",
        "!tests/api/v1/fleet-api-key.test.ts",
        "!tests/api/v1/tenant-cache-vary.test.ts",
        "!tests/api/v1/write-body-required.test.ts",
        "!tests/client/agent-editor-takeover-block.test.ts",
        "!tests/client/auth-logout-failure.test.ts",
        "!tests/client/behavior-dirty-snapshot.test.ts",
        "!tests/client/behavior-save-gate.test.ts",
        "!tests/client/bundle-boundary.test.ts",
        "!tests/client/code-editor-completions.test.tsx",
        "!tests/client/code-tools-locale-defaults.test.ts",
        "!tests/client/contact-auth-rule-form-list.test.ts",
        "!tests/client/contact-auth-ttl-zero.test.ts",
        "!tests/client/conversation-outcomes.test.ts",
        "!tests/client/conversation-reengage-rank.test.ts",
        "!tests/client/cross-inbox-case-editor.test.ts",
        "!tests/client/dashboard-filters.test.ts",
        "!tests/client/debug-warning-source.test.ts",
        "!tests/client/document-preview-height.test.tsx",
        "!tests/client/editor-forced-save-replace.test.ts",
        "!tests/client/editor-narrow-rows.test.tsx",
        "!tests/client/editor-save-errors.test.ts",
        "!tests/client/editor-text-caps.test.ts",
        "!tests/client/error-toast-reason.test.ts",
        "!tests/client/field-refusal-fence.test.ts",
        "!tests/client/grant-before-refetch.test.ts",
        "!tests/client/import-warnings-rendered.test.ts",
        "!tests/client/ios-input-zoom.test.ts",
