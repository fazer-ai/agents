        "!tests/lib/outbound-family.test.ts",
        "!tests/lib/provider-boundary-sweep.test.ts",
        "!tests/lib/redact.test.ts",
        "!tests/lib/source-text.test.ts",
        "!tests/lib/tenancy.test.ts",
        "!tests/modules/audit-actions.test.ts",
        "!tests/modules/audit-channel-family.test.ts",
        "!tests/modules/audit-webhook-family.test.ts",
        "!tests/modules/billed-call-usage.test.ts",
        "!tests/modules/chatwoot-receiver.test.ts",
        "!tests/modules/chatwoot-recover-delivery.test.ts",
        "!tests/modules/credential-reader-fence.test.ts",
        "!tests/modules/delivery-sweep.test.ts",
        "!tests/modules/document-tool-name-single-source.test.ts",
        "!tests/modules/flowlog-alert-summary.test.ts",
        "!tests/modules/flowlog-debug-mode.test.ts",
        "!tests/modules/followup-eligibility.test.ts",
        "!tests/modules/gate-close.test.ts",
        "!tests/modules/late-media-ingest.test.ts",
        "!tests/modules/mcp/write-passes-its-client.test.ts",
        "!tests/modules/operator-text-surface.test.ts",
        "!tests/modules/playground-tenant-selector.test.ts",
        "!tests/modules/reengage-gate-atomic.test.ts",
        "!tests/modules/scheduler-row-writers.test.ts",
        "!tests/modules/tenant-selector-entry-points.test.ts",
        "!tests/modules/terminal-failure-fence.test.ts",
        "!tests/modules/vault/base-url-applicability.test.ts",
        "!tests/prisma/delivery-route-observed-migration.test.ts",
        "!tests/prisma/drop-retired-label-settings-migration.test.ts",
        "!tests/prisma/native-tool-names-renamed-by-migration.test.ts",
        "!tests/utils/comment-blocks.ts",
        "!tests/utils/followup-step-fields.ts",
        "!tests/utils/source-text.ts"
      ],
      "plugins": ["./biome-plugins/no-test-reads-source.grit"]
    },
    {
      "includes": [
        "tests/**/*.{ts,tsx}",
        "!tests/api/features/realtime/realtime-revocation.test.ts",
        "!tests/api/features/realtime/realtime.controller.test.ts",
        "!tests/api/middlewares/webhookRateLimit.test.ts",
        "!tests/client/agent-document-create.test.tsx",
        "!tests/client/code-editor-completions.test.tsx",
        "!tests/client/company-modal-reopen.test.tsx",
