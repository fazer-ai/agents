// Refuses `verifyPassword(...)` outside the files biome.jsonc exempts: its definition, src/api/lib/step-up.ts,
// and the two places where a password IS the credential and no session exists yet (the login route, and
// accepting an invitation into an existing account). A step-up goes through `confirmStepUp`, which knows
// that a key minted under a step-up answers it by itself.
language js;

or {
    JsCallExpression(callee = $callee) as $site where { $callee <: r"(?:[\s\S]*\.)?verifyPassword" },
    JsFunctionDeclaration(id = $id) as $site where { $id <: "verifyPassword" }
} where {
    register_diagnostic(span = $site, message = "A step-up goes through `confirmStepUp` (src/api/lib/step-up.ts), not a direct `verifyPassword` call (docs/api-and-fleet.md, the section on step-up being a property of the session).")
}
