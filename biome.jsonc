        "!tests/client/pages/CodeToolTestModal.test.ts",
        "!tests/client/pages/ToolEditModal.test.tsx",
        "!tests/client/playground-agent-turn.test.ts",
        "!tests/client/realtime-event-fields.test.ts",
        "!tests/client/reengage-outcome-messages.test.ts",
        "!tests/client/send-image-editor.test.tsx",
        "!tests/client/shell-scroll-containment.test.ts",
        "!tests/client/signature-preview-vars.test.ts",
        "!tests/client/stale-notice-bar.test.tsx",
        "!tests/client/tool-label.test.ts",
        "!tests/client/tool-path-picker-affordance.test.tsx",
        "!tests/client/tool-preconditions-editor.test.ts",
        "!tests/client/tool-sample-persistence.test.ts",
        "!tests/client/window-open-api-path.test.ts",
        "!tests/config.test.ts",
        "!tests/graph/cross-inbox-case-wiring.test.ts",
        "!tests/graph/fallback-flow-labels.test.ts",
        "!tests/graph/job-deadline-graph.test.ts",
        "!tests/graph/nudge-retry.test.ts",
        "!tests/graph/nudge-waits-for-turn.test.ts",
        "!tests/graph/prepare.test.ts",
        "!tests/graph/refused-turn-callsites.test.ts",
        "!tests/graph/silence.test.ts",
        "!tests/graph/still-wanted-strictness.test.ts",
        "!tests/graph/tool-flowlog.test.ts",
        "!tests/graph/trace.test.ts",
        "!tests/graph/turn-delivered.test.ts",
        "!tests/graph/usage-provider-counts.test.ts",
        "!tests/lib/caller-id-spelling.test.ts",
        "!tests/lib/db-guard.test.ts",
        "!tests/lib/db-pool-documented.test.ts",
