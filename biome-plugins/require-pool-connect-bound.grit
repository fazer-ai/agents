// Refuses, under src/, a `new Pool({…})` (also `new pg.Pool({…})`) or a `new PrismaPg({…})` (which builds its own pool) whose
// options bound neither the connect nor the queue: `pg`'s default for `connectionTimeoutMillis` is 0,
// so a connect stalled by the network, or by a Postgres that accepts the TCP connection and never
// answers, holds whatever waits on it forever. Spread `connectTimeoutOption()` from
// src/api/lib/pool-options.ts to bound the connect alone, or set `connectionTimeoutMillis` where a
// bounded wait for a free client is also wanted. Options built elsewhere (`new Pool(fn())`) are the
// builder's to bound and are not judged here.
language js;

JsNewExpression() as $new where {
    $new <: r"(?s)new\s+(?:[\w$]+\s*\.\s*)?(?:Pool|PrismaPg)\s*\(\s*\{.*",
    not $new <: r"(?s).*(?:connectionTimeoutMillis|connectTimeoutOption\s*\().*",
    register_diagnostic(span = $new, message = "A pool's options bound its connect: spread `connectTimeoutOption()` (src/api/lib/pool-options.ts), or set `connectionTimeoutMillis` when the wait for a free client should be bounded too.")
}
