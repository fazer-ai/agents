// Refuses a write to `webhookSubscription` outside src/modules/webhooks/outbound/subscriptions.ts and
// to `alertChannel` outside src/modules/flowlog/channels.ts. Their audit projections carry `secretRef`
// in full on the grounds that it is a reference, which holds only because these two services are its
// writers and both canonicalize it through `requireVaultRef`.
language js;

JsCallExpression(callee = $callee) as $call where {
    or {
        and {
            $callee <: r"(?:[\s\S]*\.)?webhookSubscription\.(?:create|createMany|update|updateMany|upsert)[A-Za-z0-9_]*",
            not $filename <: r".*src/modules/webhooks/outbound/subscriptions\.ts"
        },
        and {
            $callee <: r"(?:[\s\S]*\.)?alertChannel\.(?:create|createMany|update|updateMany|upsert)[A-Za-z0-9_]*",
            not $filename <: r".*src/modules/flowlog/channels\.ts"
        }
    },
    register_diagnostic(span = $call, message = "Only the owning service writes this table (subscriptions.ts for webhookSubscription, channels.ts for alertChannel), which canonicalizes `secretRef` through `requireVaultRef`.")
}
