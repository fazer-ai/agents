// Refuses a real wait of 50ms or more in a test: `Bun.sleep(n)` or `setTimeout(fn, n)` whose delay
// is a numeric literal of 50 or more (`50`, `5_0`, `1_000`, `50.5`). A deadline or a cadence a test
// waits out costs that time on every run, and the margin sized for an idle machine is what fails
// under `--parallel`. Inject the clock (or use fake timers) and wait for a condition with `until`
// from tests/utils/poll.ts. Short sleeps that only order two writes within a millisecond stay
// allowed, and a delay held in a variable is not matched. Files that predate the rule are listed in
// biome.jsonc. GritQL anchors a regex to the whole literal and does not take a `|` group, so the
// threshold is four alternatives: 50-99 and 100+, each as an integer and as a decimal.
language js;

or {
    `Bun.sleep($ms)` as $call,
    `setTimeout($fn, $ms)` as $call
} where {
    $ms <: JsNumberLiteralExpression(),
    or {
        $ms <: r"[5-9]_?[0-9][0-9_]*",
        $ms <: r"[1-9]_?[0-9]_?[0-9][0-9_]*",
        $ms <: r"[5-9]_?[0-9][0-9_]*\.[0-9_]*",
        $ms <: r"[1-9]_?[0-9]_?[0-9][0-9_]*\.[0-9_]*"
    },
    register_diagnostic(span = $call, message = "A test does not wait real time: inject the clock or use fake timers, and wait for a condition with `until` from tests/utils/poll.ts (testes.md, T6).")
}
