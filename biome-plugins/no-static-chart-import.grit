// Refuses a static import of the chart library, or of the console's chart module, outside the chart
// modules themselves. Every page is reached from the app's routes without a dynamic import, so a
// static import puts Recharts on the login screen and every other one; a chart is a module of its own
// that its page loads with `lazyWithReload` (docs/dashboards.md). A type-only import loads nothing.
// The chart modules are out of scope in biome.jsonc.
language js;

JsImport() as $import where {
    $import <: r"[\s\S]*from\s*\"(?:recharts(?:/[^\"]*)?|@/client/pages/dashboard/charts|\./charts)\"[\s\S]*",
    not $import <: r"import\s+type\b[\s\S]*",
    register_diagnostic(span = $import, message = "Import charts only from a chart module, loaded with `lazyWithReload`: a static import puts the chart library on every screen.")
}
