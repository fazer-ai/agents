# NOTE: Every numeric setting in this file must be a positive WHOLE number, and boot REFUSES
# anything else by name instead of falling back to the default. Falling back is how a typo becomes a
# value nobody chose: `Number("15s")` is NaN and `Number("1e309")` is Infinity. The five settings
# that drive a worker's tick pass their value straight to `setInterval`, which cannot represent
# either and uses 1ms instead, so a line reading "every 15 seconds" becomes about 870 database
# claims a second. The ones that feed date arithmetic fail more quietly: an Invalid Date cutoff
# means the daily log sweep deletes nothing. Each setting also has an upper bound, named in the
# error: a duration caps at what a 32-bit delay can hold, a port at 65535, and so on.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:${PORT}
LOG_LEVEL=info

JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-in-production
# NOTE: Signing key for MCP OAuth access tokens — SEPARATE from JWT_SECRET (the app cookie) so the
# two realms cannot be confused. If unset, derives from JWT_SECRET (still distinct); set an
# independent strong value in production.
MCP_JWT_SECRET=
CORS_ORIGIN=localhost:${PORT}

# NOTE: Separate the port variable to allow overriding in docker-compose
POSTGRES_PORT=5432

# NOTE: Runtime connection. MUST be a NON-SUPERUSER, NON-BYPASSRLS role, or the
# Row-Level-Security tenant isolation becomes a no-op (superusers/owners bypass RLS).
# Provision the role + pgvector extension once via scripts/db-bootstrap.sql. The server
# fails fast at boot if this role is privileged (see ALLOW_SUPERUSER_RUNTIME).
DATABASE_URL=postgres://fazerai_app:fazerai_app_pw@localhost:${POSTGRES_PORT}/fazerai_agents_db

# NOTE: Local-dev escape hatch ONLY. When the runtime DATABASE_URL points at the Postgres
# superuser (common locally), boot would refuse to start (RLS is a no-op). Set this to "true"
# to downgrade that hard failure to a warning. NEVER set in production. Ignored when
# NODE_ENV=production (boot always fails for a privileged runtime role there).
# ALLOW_SUPERUSER_RUNTIME=false

# NOTE: Migrations / DDL connection. A superuser or DB owner (needs CREATE EXTENSION,
# enum/role changes). Falls back to DATABASE_URL when unset, but the two MUST differ in
# production so the runtime never holds superuser. Used by prisma.config.ts and migrate jobs.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:${POSTGRES_PORT}/fazerai_agents_db

# NOTE: LangGraph PostgresSaver checkpointer pool. Non-superuser (RLS-respecting); the pool
# sets search_path=langgraph per connection. Defaults to DATABASE_URL when unset.
LANGGRAPH_DATABASE_URL=postgres://fazerai_app:fazerai_app_pw@localhost:${POSTGRES_PORT}/fazerai_agents_db

# NOTE: Global cap on concurrent agent model calls (the LLM round-trip in the LangGraph agent node +
# the opt-in TTS-normalize call), applied process-wide across every entrypoint (debounce/webhook/
# nudge/playground). Conversations drain in parallel; this is the only throttle on model calls, so a
# burst does not hammer the provider. Default 20 (per-process, single-replica).
AGENT_MODEL_CONCURRENCY=20
# NOTE: Hard cap (characters) on an agent's system prompt, enforced when creating/updating/importing
# an agent on every transport (console, REST v1, MCP). Prompts past tens of KB usually hold content
# that belongs in the knowledge base (RAG) and degrade instruction adherence; raise this only as a
# deliberate decision. Default 100000.
AGENT_PROMPT_MAX_CHARS=100000
# NOTE: Max connections for BOTH pg pools against the (dedicated) Postgres — the main Prisma pool and
# the LangGraph checkpointer pool. Size it so agent turns drain in parallel without the pool being the
# bottleneck (pairs with AGENT_MODEL_CONCURRENCY). Total connections per leader replica are ~2×this;
# keep under the server's max_connections (pg default 100). Beyond ~40, raise max_connections instead.
DB_POOL_MAX=30

# NOTE: Langfuse tracing is configured PER-TENANT (a "langfuse" vault entry holding
# {publicKey, secretKey, baseUrl, sendContent?}), never a global env var — a shared key would
# leak every tenant's traces. Content is redacted unless the tenant sets sendContent:true.
# LLM cost lives in the local LlmUsage table (captured at the source), not in Langfuse.

# NOTE: the integration suite runs against a DEDICATED test database (fazerai_agents_test), NOT the
# dev DB — it does destructive, unscoped ops (e.g. `DELETE FROM scheduler_jobs`) and creates/drops
# tenants, which would wipe live dev data on every `bun test` if pointed at the dev DB. Provision
# it once with `bun db:test:setup` (creates the DB, bootstraps the app role, runs migrations).
# Unset both = the integration tests skip (e.g. CI without a database).
# - TEST_APP_DATABASE_URL: app-role (non-superuser) connection, exercises RLS.
# - TEST_MIGRATION_DATABASE_URL: superuser connection for the suite's setup/teardown. tests/setup.ts
#   redirects MIGRATION_DATABASE_URL to this at preload (guarding the name ends in `_test`), so the
#   Prisma CLI keeps using the dev MIGRATION_DATABASE_URL while tests hit the test DB.
TEST_APP_DATABASE_URL=postgres://fazerai_app:fazerai_app_pw@localhost:${POSTGRES_PORT}/fazerai_agents_test
TEST_MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:${POSTGRES_PORT}/fazerai_agents_test

# NOTE: Server-side CDN URL for backend use (e.g. constructing absolute asset URLs in emails)
CDN_URL=${PUBLIC_URL}

# NOTE: Public env vars are exposed to the frontend via BUN_PUBLIC_ prefix
BUN_PUBLIC_CDN_URL=${CDN_URL}

# NOTE: Optional Google Sign-In via Google Identity Services (GIS). Leave empty to disable.
# Create an OAuth 2.0 Client ID (Web application) at https://console.cloud.google.com/apis/credentials
# Add your Authorized JavaScript origins (e.g. http://localhost:3000 in dev, https://yourdomain in prod).
# Client secret is NOT required; the backend verifies the ID token against Google's JWKS.
GOOGLE_CLIENT_ID=

# NOTE: Public registration is opt-in. Defaults to false: both email/password signup
# (POST /api/auth/signup) and first-time Google sign-in (new accounts) are refused, while
# existing users keep logging in normally. Set to true to open public signup. The first
# admin account is always created through the first-run /setup flow, never via signup.
SIGNUP_ENABLED=false

# NOTE: Protects the first-run /setup window. When true (the default), the server prints a
# one-time setup token (and a ready-to-use /setup URL) in its log on first start while no
# users exist; the setup form requires that token. Set to false to allow /setup without a
# token (only on trusted networks, e.g. behind a firewall during provisioning). The guided
# onboarding deploy (scripts/gen-onboarding-env.ts) generates this as false, since the operator
# drives /setup right after provisioning; this default stays true for every other deploy.
SETUP_TOKEN_REQUIRED=true

# NOTE: Outbound webhook delivery worker. Enabled by default; set to false for CLIs or
# one-off scripts that import the app but should not run background delivery. Single-replica
# by construction (a reentrancy guard + interval) — scaling the app beyond one replica needs
# a leader election or durable claim before enabling on every instance.
WEBHOOK_WORKER_ENABLED=true
# NOTE: Tick interval in milliseconds for the outbound webhook worker (default 5000).
WEBHOOK_WORKER_INTERVAL_MS=5000

# NOTE: Follow-up/sweep scheduler worker. Same single-replica discipline as the outbound worker
# (globalThis singleton + non-overlapping tick + FOR UPDATE SKIP LOCKED claim). Disable for CLIs.
SCHEDULER_WORKER_ENABLED=true
# NOTE: Tick interval in milliseconds for the scheduler worker (default 15000).
SCHEDULER_WORKER_INTERVAL_MS=15000

# NOTE: Dedicated fast worker that drains DEBOUNCE jobs (inbound message coalescing). Separate from
# the scheduler so the per-agent debounce window (seconds) is honored without ticking the reaper/sweep
# that fast. Same single-replica discipline. Disable for CLIs. The per-agent window/enable lives on
# the agent (UI/REST/MCP); this is only the operational drain cadence.
DEBOUNCE_WORKER_ENABLED=true
# NOTE: Tick interval in milliseconds for the debounce worker (default 2500). Keep it well below the
# smallest debounce window an agent can configure (3s) so flushes fire close to the window's end.
DEBOUNCE_WORKER_INTERVAL_MS=2500

# NOTE: Dedicated worker that drains MEMORY_COMPACT jobs (summarizing a closed attendance). Separate
# from the scheduler for the mirror image of the reason above: the scheduler runs its jobs one at a
# time and a summary is a model call with a 60s ceiling, so on the shared lane a batch of them would
# delay follow-ups and appointment reminders by minutes. Same single-replica discipline. Disable for
# CLIs. The per-agent switch lives on the agent (UI/REST/MCP); this is only the drain cadence.
COMPACTION_WORKER_ENABLED=true
# NOTE: Tick interval in milliseconds for the compaction worker (default 15000). Nothing here is
# time-sensitive — the resolve trigger already waits out a 15-minute grace — so it matches the
# scheduler's cadence rather than the fast lane's.
COMPACTION_WORKER_INTERVAL_MS=15000

# NOTE: Cadence (ms) of the periodic `heartbeat` outbound webhook — a liveness ping a monitor can
# subscribe to. Runs on the scheduler worker (no separate process); only fires for tenants with an
# enabled subscription to the `heartbeat` event. Default 60000 (1 min).
HEARTBEAT_INTERVAL_MS=60000

# NOTE: External alert delivery worker (execution-flow warnings/errors → Discord / generic webhook).
# Single-replica discipline (globalThis singleton + reentrancy guard); set to false on extra replicas.
ALERT_WORKER_ENABLED=true
# NOTE: Tick interval (ms) for the alert worker (default 10000).
ALERT_WORKER_INTERVAL_MS=10000
# NOTE: Debounce window (ms): a freshly-created alert delivery waits this long before the worker
# claims it, so a burst of identical events coalesces into one delivery (count) before the POST.
# Default 30000 (30s).
ALERT_COALESCE_WINDOW_MS=30000
# NOTE: Retention (days) for the high-write execution_logs table (+ terminal alert_deliveries). A
# daily per-tenant FLOWLOG_SWEEP job deletes older rows. Default 30.
FLOWLOG_RETENTION_DAYS=30

# NOTE: Per-client rate-limit ceilings (requests/minute). Runaway guards, not tight throttles: the
# console fires dozens of parallel reads per navigation, and one MCP client funnels every tool call
# through a single address. Raise if a shared-NAT deployment trips them. Defaults: user 600, MCP 1200.
RATE_LIMIT_USER_PER_MIN=600
RATE_LIMIT_MCP_PER_MIN=1200
# NOTE: The credential endpoints (login, signup, the one-time /setup token, accept-invite) get a
# SECOND, tighter bucket on top of the global one. The window is minutes rather than one minute on
# purpose: a per-minute ceiling resets 60 times an hour, so 10/min would still allow 600 password
# guesses an hour against one account. 20 per 5 minutes is 240 an hour and still absorbs a burst,
# which is what a whole office signing in at once looks like through a single NAT. Raise the max if
# yours trips it. Boot refuses a value that collides with another limiter's budget+window (they are
# deduplicated by the plugin, and the loser silently stops limiting) or that is not tighter than
# RATE_LIMIT_USER_PER_MIN. All four of these must be positive WHOLE numbers, and boot refuses
# anything else by name rather than falling back: a window the limiter cannot turn into a date (an
# `Infinity`, which is also what `1e309` parses to) makes it advertise `RateLimit-Reset: NaN` and
# never reset, so the endpoints it guards answer 429 for good once the budget is spent.
RATE_LIMIT_CREDENTIAL_MAX=20
RATE_LIMIT_CREDENTIAL_WINDOW_MINUTES=5

# NOTE: Who the limits above apply to. The app sees the reverse proxy as the client of every request,
# so until TRUST_PROXY is on, the whole deployment shares one bucket.
# Turn it on only when BOTH hold, because either one alone is a bypass:
#   1. The app port is unreachable except through your proxy. docker-compose.prod.yml publishes it on
#      every interface by default, and anyone who can reach it directly could otherwise send an
#      X-Forwarded-For of their choosing and give themselves a private bucket. Narrow the binding
#      (APP_PORT=127.0.0.1:3000) or firewall it first. This is not derived from the source address
#      because Docker's userland proxy rewrites a direct caller to the same bridge address a real
#      sidecar proxy connects from, so the two cannot be told apart.
#      With TRUSTED_PROXY_HOPS above 1 this applies to EVERY proxy you counted, not just to this app:
#      a reachable origin behind a CDN is the same bypass one layer out. Reaching the origin directly
#      with an X-Forwarded-For of your own produces a chain the same length as the CDN path, so the
#      entry this reads is the forged one and nothing in the request distinguishes the two. Restrict
#      the origin to the CDN's ranges before counting the CDN as a hop.
#   2. Your proxy OVERWRITES or APPENDS to X-Forwarded-For rather than passing the client's value
#      through. Caddy and Traefik overwrite by default; nginx does only with
#      `$proxy_add_x_forwarded_for` — the `$http_x_forwarded_for` spelling forwards whatever the
#      client sent, which puts the last entry back under the client's control.
# TRUSTED_PROXY_HOPS is how many proxies sit in front, counted from the END of the chain, because a
# proxy appends what it saw and a client can prepend but never append. Raising it only helps if the
# proxy NEAREST to this app preserves the chain it received: measured, Caddy with no `trusted_proxies`
# discards the incoming chain entirely and emits just its own peer, so behind a CDN the app would key
# on the CDN unless Caddy is told to trust it — and a hop count larger than the chain falls back to
# the peer, putting everyone in one bucket again. Leave it at 1 unless you have configured the
# nearest proxy to forward the upstream chain.
# This is a limit on one source either way, not brute-force protection: everyone behind one NAT
# still shares a bucket.
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1

# NOTE: Allow stdio MCP servers (spawns a local process = RCE risk in multi-tenant hosting).
# OFF by default; enable only on a single-tenant/self-hosted box you control. When off, a stdio
# connection still saves but never runs, and the MCP form flags it as disabled. A stdio server's
# token is supplied via an `mcp_env` vault credential (value = token, param name = the env var the
# process reads, e.g. API_TOKEN); it is injected as a process env var, never in the command.
MCP_STDIO_ENABLED=false

# NOTE: RFC 7591 Dynamic Client Registration on our MCP server: MCP clients (Claude Code, Codex,
# Cursor, mcp-remote) self-register instead of being pre-registered by hand. ON by default, because
# none of them has a fallback — without `registration_endpoint` in the metadata, Codex fails with
# "Dynamic client registration not supported" and Claude Code with "Incompatible auth server", both
# before any login screen, and pre-registering a client does not help Codex (its loopback callback
# uses a random port while /authorize matches redirect_uri exactly). A self-registered client is
# shown as "unverified" on the consent screen and never skips it; /register is rate-limited; the
# granted scopes stay role-gated. Set to `false` to close it (the endpoint then 404s) only on a
# deployment that serves no external MCP client.
MCP_DCR_ENABLED=true

# NOTE: Filesystem root for generated quote PDFs (<dir>/<tenantId>/<quoteId>.pdf). Served ONLY
# via the authenticated, tenant-scoped /api/v1/quotes/:id/pdf route — never under staticPlugin.
# Use a persistent volume in production (e.g. /app/storage/quotes).
QUOTES_STORAGE_DIR=./data/quotes

# NOTE: Filesystem root for the GLOBAL identity assets (logo/favicon, at most 4 files). Served
# via the public /api/v1/branding/asset/:kind/:variant route. Use a persistent volume in
# production (e.g. /app/storage/branding).
BRANDING_STORAGE_DIR=./data/branding

# NOTE: Optional comma-separated list of email domains allowed to register new accounts.
# Leave empty to allow any domain. Applies to both email/password signup and Google OAuth
# first-time sign-in (only when SIGNUP_ENABLED=true). Does not affect existing users,
# account linking, or the first-run /setup admin.
# Example: ALLOWED_SIGNUP_DOMAINS=example.com,mycompany.io
ALLOWED_SIGNUP_DOMAINS=

# NOTE: Optional comma-separated list of email domains whose new accounts are auto-promoted
# to ADMIN on signup. Leave empty for no auto-promotion (the default). Auto-promotion only
# fires for verified channels (Google first-time sign-in with email_verified=true). Plain
# email/password signups are always created as USER even when the domain matches, because
# there is no proof the registrant controls the address. Promote password accounts manually
# with `bun set-admin <email>`. Existing users are not affected.
#
# THREAT MODEL: Anyone who can obtain a Google ID token with email_verified=true for a
# listed domain will receive ADMIN on first sign-in. That includes any Google Workspace
# admin (who can provision arbitrary @yourdomain addresses), any insider with a legitimate
# account, anyone who compromises Workspace admin credentials or DNS, and anyone who
# exploits a Google provisioning bug. "Control of an email address" is NOT the same as
# "entitled to ADMIN in this app". Only enable this if the Workspace controlling the
# domain is operated by the same group that should have admin control over this app.
# Otherwise leave empty and promote admins explicitly with `bun set-admin`.
# Example: ADMIN_SIGNUP_DOMAINS=mycompany.io
ADMIN_SIGNUP_DOMAINS=

# NOTE: Relaxes the anti-SSRF guard to allow private/loopback/link-local targets and plain http.
# Useful when operators need to reach local services during development (e.g. a local MCP server or
# HTTP tool). Defaults to true in development (NODE_ENV=development) and false in production.
# Set explicitly to "true" or "false" to override the environment-based default. Never set to
# "true" in production unless you fully trust all operator-configured URLs.
# SSRF_ALLOW_PRIVATE_TARGETS=false

# NOTE: Central fazer.ai hub (app.fazer.ai) serving the operator announcements (top banner) and the
# "new version available" check. Default https://app.fazer.ai. Set to EMPTY to disable ALL hub
# communication (air-gapped, or a fork that does not want to talk to fazer.ai). For the Free edition
# this is a light update check that sends edition + current version + request IP (no PII).
FAZER_AI_HUB_URL=https://app.fazer.ai

# NOTE: Optional override for the version check ONLY (forks with their own release cadence). Point it
# at a URL returning { "latestVersion": "x.y.z", "releaseUrl"?: "https://..." }. Empty = derive from the hub.
AGENTS_UPDATE_CHECK_URL=

# NOTE: Cache TTL (ms) for the hub announcements/version fetch on the backend. Default 3600000 (1h).
HUB_UPDATES_TTL_MS=3600000
