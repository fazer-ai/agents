{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.{ts,tsx}"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "includes": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.{ts,tsx}"],
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useSortedClasses": "warn"
      },
      "style": {
        "noJsxLiterals": {
          "level": "warn",
          "options": {
            "noStrings": false,
            "ignoreProps": true,
            "allowedStrings": [
              "·",
              "•",
              "×",
              "→",
              "/",
              "|",
              "?",
              "*",
              "(",
              ")",
              "%"
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/client/**/*.{ts,tsx}", "!src/client/lib/env.ts"],
      "plugins": ["./biome-plugins/no-bun-public-env.grit"]
    },
    {
      "includes": ["src/client/**/*.{ts,tsx}"],
      "plugins": [
        "./biome-plugins/no-dynamic-i18n-key.grit",
        "./biome-plugins/no-t-rename.grit",
        "./biome-plugins/always-render-modal.grit"
      ]
    },
    {
      "includes": ["src/api/**/*.ts"],
      "plugins": ["./biome-plugins/no-dynamic-translate-key.grit"]
    },
    {
      "includes": ["src/modules/**/*.ts", "tests/lint/.probe-*/**/*.ts"],
      "plugins": ["./biome-plugins/require-resolution-hooks.grit"]
    },
    {
      "includes": ["src/client/pages/*.tsx"],
      "plugins": ["./biome-plugins/require-page-container.grit"]
    },
    // The repo-wide source rules. Each also applies under tests/lint/.probe-src-*, where
    // tests/lint/source-rules.test.ts feeds it a violating and a conforming snippet.
    {
      "includes": ["src/**/*.tsx", "tests/lint/.probe-src-*/**/*.tsx"],
      "plugins": ["./biome-plugins/no-noop-close-request.grit"]
    },
    {
      "includes": ["src/**/*.ts", "tests/lint/.probe-src-*/**/*.ts"],
      "plugins": ["./biome-plugins/require-pool-connect-bound.grit"]
    },
    {
      "includes": [
        "src/**/*.{ts,tsx}",
        "!src/lib/pg-error.ts",
        "tests/lint/.probe-src-*/**/*.{ts,tsx}"
      ],
      "plugins": ["./biome-plugins/no-raw-violation-code.grit"]
    },
    {
      "includes": ["src/**/*.tsx", "tests/lint/.probe-src-*/**/*.tsx"],
      "plugins": ["./biome-plugins/no-jsx-comment-note.grit"]
    },
    {
      "includes": [
        "src/**/*.{ts,tsx}",
        "tests/lint/.probe-src-*/**/*.{ts,tsx}"
      ],
      "plugins": [
        "./biome-plugins/no-bigint-cast.grit",
        "./biome-plugins/no-scrub-around-cut.grit"
      ]
    },
    // A file below reads the environment for a reason config cannot serve. src/lib/instance.ts:
    // INSTANCE_ID, imported by config's own consumers at module load and pinned per replica, with a
    // fresh UUID as default, which config cannot express as a static value.
    // src/modules/vision/convert/heic.ts: VISION_LIBHEIF_WASM_PATH, an operator override for the
    // decoder's location read where the library is loaded, documented beside LIBHEIF_WASM_PATH_ENV.
    // src/client/lib/env.ts: the browser bundle, where Bun inlines `process.env.BUN_PUBLIC_*` at
    // build time and config is server-only.
    {
      "includes": [
        "src/**/*.{ts,tsx}",
        "!src/config.ts",
        "!src/lib/instance.ts",
        "!src/modules/vision/convert/heic.ts",
        "!src/client/lib/env.ts",
        "tests/lint/.probe-src-*/**/*.{ts,tsx}"
      ],
      "plugins": ["./biome-plugins/no-env-read-outside-config.grit"]
    },
    // src/graph/model-limit.ts defines runModelCall and holds the default the rule keeps callers off.
    {
      "includes": [
        "src/**/*.ts",
        "!src/graph/model-limit.ts",
        "tests/lint/.probe-src-*/**/*.ts"
      ],
      "plugins": ["./biome-plugins/require-model-call-deadline.grit"]
    },
    {
      "includes": ["tests/**/*.{ts,tsx}", "!tests/utils/source-text.ts"],
      "plugins": ["./biome-plugins/no-raw-read-of-globbed-source.grit"]
    },
    // Module stubs in every file under tests/, support files included: a stub installed by a helper is
    // as process-wide as one in a test file.
    {
      "includes": ["tests/**/*.{ts,tsx}"],
      "plugins": [
        "./biome-plugins/no-package-module-mock.grit",
        "./biome-plugins/no-module-mock-live-namespace.grit",
        "./biome-plugins/no-raw-auth-context-mock.grit"
      ]
    },
    // The two test rules below (tooling/process/agents-ship/testes.md, T5 and T6) carry the files that
    // predate them as negated entries. The list only shrinks: a file leaves it when it is cleaned up,
    // and a new file never enters it.
    {
      "includes": [
        "tests/**/*.{ts,tsx}",
        "!tests/tooling/**",
        "!tests/api/error-catalog.test.ts",
        "!tests/api/lib/refusal-callsites.test.ts",
        "!tests/client/debug-warning-source.test.ts",
        "!tests/client/error-toast-reason.test.ts",
        "!tests/client/field-refusal-fence.test.ts",
        "!tests/client/locale-plurals.test.ts",
        "!tests/client/tool-sample-persistence.test.ts",
        "!tests/graph/prepare.test.ts",
        "!tests/lib/jsx-comment-tag-sweep.test.ts",
        "!tests/lib/source-text.test.ts",
        "!tests/modules/audit-actions.test.ts",
        "!tests/modules/audit-channel-family.test.ts",
        "!tests/modules/chatwoot-recover-delivery.test.ts",
        "!tests/modules/credential-reader-fence.test.ts",
        "!tests/modules/flowlog-alert-summary.test.ts",
        "!tests/modules/flowlog-debug-mode.test.ts",
        "!tests/modules/mcp/write-passes-its-client.test.ts",
        "!tests/modules/operator-text-surface.test.ts",
        "!tests/modules/tenant-selector-entry-points.test.ts",
        "!tests/modules/terminal-failure-fence.test.ts",
        "!tests/modules/vault/base-url-applicability.test.ts",
        "!tests/scripts/ci-required-contexts.test.ts",
        "!tests/utils/comment-blocks.ts",
        "!tests/utils/source-text.ts"
      ],
      "plugins": ["./biome-plugins/no-test-reads-source.grit"]
    },
    {
      "includes": [
        "tests/**/*.{ts,tsx}",
        "!tests/api/features/realtime/realtime-revocation.test.ts",
        "!tests/api/features/realtime/realtime.controller.test.ts",
        "!tests/api/middlewares/webhookRateLimit.test.ts",
        "!tests/config.test.ts",
        "!tests/graph/code-sandbox.test.ts",
        "!tests/graph/side-effect-flowlog.test.ts",
        "!tests/graph/tool-flowlog.test.ts",
        "!tests/graph/tool-schema-refusal.test.ts",
        "!tests/graph/tools-http-body-bound.test.ts",
        "!tests/graph/tools.test.ts",
        "!tests/lib/shutdown-drain.test.ts",
        "!tests/modules/alert-channel-test.test.ts",
        "!tests/modules/analytics-costs.test.ts",
        "!tests/modules/audit-actor-family.test.ts",
        "!tests/modules/audit-config-families.test.ts",
        "!tests/modules/chatwoot-annotations.test.ts",
        "!tests/modules/chatwoot-gate-trail.test.ts",
        "!tests/modules/chatwoot-human-reply-takeover.test.ts",
        "!tests/modules/chatwoot-mirror-hot-rows.test.ts",
        "!tests/modules/chatwoot-mirror-once.test.ts",
        "!tests/modules/chatwoot-out-of-office.test.ts",
        "!tests/modules/chatwoot-reset.test.ts",
        "!tests/modules/chatwoot-unbound-inbox.test.ts",
        "!tests/modules/code-tools.test.ts",
        "!tests/modules/contact-auth-budget.test.ts",
        "!tests/modules/contact-auth-media.test.ts",
        "!tests/modules/contact-auth-observer.test.ts",
        "!tests/modules/contact-auth-stages.test.ts",
        "!tests/modules/debounce-awaits-stt.test.ts",
        "!tests/modules/debounce.test.ts",
        "!tests/modules/delivery-sweep.test.ts",
        "!tests/modules/eager-media-flow-context.test.ts",
        "!tests/modules/flowlog-settle.test.ts",
        "!tests/modules/grant-target-vanishes.test.ts",
        "!tests/modules/mcp-webhook-deliveries.test.ts",
        "!tests/modules/memory-dead-letter.test.ts",
        "!tests/modules/observe-decisions.test.ts",
        "!tests/modules/observe-job.test.ts",
        "!tests/modules/playground-guardrails.test.ts",
        "!tests/modules/rag-suggestion-review.test.ts",
        "!tests/modules/scheduler-lanes.test.ts",
        "!tests/modules/scheduler-shutdown-drain.test.ts",
        "!tests/modules/scheduler-unless-claimed.test.ts",
        "!tests/modules/scheduler.test.ts",
        "!tests/modules/stt.test.ts",
        "!tests/modules/tool-test-run.test.ts",
        "!tests/modules/vision-email-body.test.ts",
        "!tests/modules/vision-retry.test.ts",
        "!tests/modules/webhooks-outbound-dead-alert.test.ts"
      ],
      "plugins": ["./biome-plugins/no-test-real-wait.grit"]
    },
    // The fences that were sweeps in tests/ (api, client, graph, modules). Each also applies under
    // tests/lint/.probe-fence-*, where tests/lint/fence-rules.test.ts feeds it a violating and a
    // conforming snippet. A negated path is the module that owns what the rule keeps everyone else off.
    {
      "includes": [
        "src/**/*.{ts,tsx}",
        "tests/lint/.probe-fence-*/**/*.{ts,tsx}"
      ],
      "plugins": [
        "./biome-plugins/no-error-key-cast.grit",
        "./biome-plugins/require-reply-rule-on-final-text.grit",
        "./biome-plugins/no-secret-ref-write-outside-owner.grit"
      ]
    },
    {
      "includes": [
        "src/**/*.{ts,tsx}",
        "!src/api/features/auth/auth.service.ts",
        "!src/api/features/auth/auth.controller.ts",
        "!src/api/features/invitations/invitation.service.ts",
        "!src/api/lib/step-up.ts",
        "tests/lint/.probe-fence-*/**/*.{ts,tsx}"
      ],
      "plugins": ["./biome-plugins/no-verify-password-outside-login.grit"]
    },
    {
      "includes": [
        "src/**/*.{ts,tsx}",
        "!src/api/lib/step-up.ts",
        "tests/lint/.probe-fence-*/**/*.{ts,tsx}"
      ],
      "plugins": ["./biome-plugins/step-up-takes-boundary-principal.grit"]
    },
    {
      "includes": ["src/**/*.ts", "tests/lint/.probe-fence-*/**/*.ts"],
      "plugins": [
        "./biome-plugins/no-constrained-zod-record.grit",
        "./biome-plugins/no-gemini-builtin-tool.grit",
        "./biome-plugins/require-usage-sink.grit"
      ]
    },
    {
      "includes": [
        "src/modules/**/*.ts",
        "src/api/**/*.ts",
        "tests/lint/.probe-fence-*/**/*.ts"
      ],
      "plugins": ["./biome-plugins/require-parse-input.grit"]
    },
    {
      "includes": [
        "src/client/**/*.{ts,tsx}",
        "tests/lint/.probe-fence-*/**/*.{ts,tsx}"
      ],
      "plugins": [
        "./biome-plugins/no-window-open-api-path.grit",
        "./biome-plugins/no-unparenthesised-fallback-ternary.grit",
        "./biome-plugins/no-tautological-staleness.grit",
        "./biome-plugins/require-reload-on-dynamic-import.grit"
      ]
    },
    // ChannelRedirectTab.tsx and PlaygroundChat.tsx clamp nothing behind their textareas: channel
    // redirect messages are stored and sent whole, and the playground composer is a message the
    // operator sends, not stored settings.
    {
      "includes": [
        "src/client/pages/agents/*.tsx",
        "!src/client/pages/agents/ChannelRedirectTab.tsx",
        "!src/client/pages/agents/PlaygroundChat.tsx",
        "tests/lint/.probe-fence-*/**/*.tsx"
      ],
      "plugins": ["./biome-plugins/require-textarea-cap.grit"]
    },
    {
      "includes": [
        "src/client/pages/agents/*.tsx",
        "tests/lint/.probe-fence-*/**/*.tsx"
      ],
      "plugins": ["./biome-plugins/require-highlighted-cap.grit"]
    },
    {
      "includes": [
        "src/client/pages/agents/BehaviorTab.tsx",
        "src/client/pages/agents/PromptPanel.tsx",
        "tests/lint/.probe-fence-*/**/*.tsx"
      ],
      "plugins": ["./biome-plugins/no-sample-contact-in-preview.grit"]
    },
    {
      "includes": [
        "src/graph/nudge.ts",
        "src/graph/runtime.ts",
        "src/modules/chatwoot/webhook.ts",
        "src/modules/conversations/reengage.ts",
        "src/modules/debounce/handler.ts",
        "src/modules/followups/eligibility.ts",
        "tests/lint/.probe-fence-*/**/*.ts"
      ],
      "plugins": ["./biome-plugins/strict-ownership-passes-assignee.grit"]
    },
    {
      "includes": [
        "src/**/*.{ts,tsx}",
        "!src/modules/documents/slug.ts",
        "tests/lint/.probe-fence-*/**/*.{ts,tsx}"
      ],
      "plugins": ["./biome-plugins/no-document-tool-name-outside-slug.grit"]
    },
    {
      "includes": [
        "src/**/*.{ts,tsx}",
        "!src/modules/chatwoot/gate-close.ts",
        "tests/lint/.probe-fence-*/**/*.{ts,tsx}"
      ],
      "plugins": ["./biome-plugins/no-gate-close-outcome-outside-owner.grit"]
    },
    {
      "includes": [
        "src/modules/playground/**/*.ts",
        "tests/lint/.probe-fence-*/**/*.ts"
      ],
      "plugins": ["./biome-plugins/no-playground-tenant-context.grit"]
    },
    {
      "includes": [
        "src/**/*.ts",
        "!src/modules/scheduler/service.ts",
        "tests/lint/.probe-fence-*/**/*.ts"
      ],
      "plugins": ["./biome-plugins/no-scheduler-row-outside-service.grit"]
    },
    {
      "includes": ["src/api/**/*.ts", "tests/lint/.probe-fence-*/**/*.ts"],
      "plugins": ["./biome-plugins/no-bare-tenant-id-in-api.grit"]
    },
    // src/graph/tools/native.ts sets `ownerChanged` on a tool call's own state, which no audit row
    // carries.
    {
      "includes": [
        "src/**/*.{ts,tsx}",
        "!src/graph/tools/native.ts",
        "tests/lint/.probe-fence-*/**/*.{ts,tsx}"
      ],
      "plugins": ["./biome-plugins/no-raw-audit-marker.grit"]
    },
    {
      "includes": [
        "src/**/*.ts",
        "!src/modules/vault/service.ts",
        "tests/lint/.probe-fence-*/**/*.ts"
      ],
      "plugins": ["./biome-plugins/no-vault-entry-write-outside-service.grit"]
    },
    // tests/utils/flowlog.ts is where the settling spellings are defined, and
    // tests/modules/flowlog-settle.test.ts's subject is what a clear or a read that does not settle
    // leaves behind, so it writes the raw one to assert what it costs.
    {
      "includes": [
        "tests/**/*.{ts,tsx}",
        "!tests/utils/flowlog.ts",
        "!tests/modules/flowlog-settle.test.ts"
      ],
      "plugins": [
        "./biome-plugins/no-raw-flowlog-clear.grit",
        "./biome-plugins/no-raw-flowlog-read.grit"
      ]
    },
    {
      "includes": ["tests/**/*.{ts,tsx}"],
      "plugins": ["./biome-plugins/no-ingest-population-assertion.grit"]
    },
    {
      "includes": [
        "tests/**/*.test.{ts,tsx}",
        "tests/lint/.probe-fence-*/**/*.ts"
      ],
      "plugins": ["./biome-plugins/require-tenant-on-scheduler-drain.grit"]
    },
    // A database probe hands its refusal to `dbProbeFailed` (biome-plugins/no-swallowed-db-probe.grit).
    // No file is listed: every probe under tests/ was moved to it with the rule.
    {
      "includes": ["tests/**/*.{ts,tsx}"],
      "plugins": ["./biome-plugins/no-swallowed-db-probe.grit"]
    },
    // A test server binds loopback (biome-plugins/require-test-server-hostname.grit). No file is
    // listed: every server under tests/ was moved to 127.0.0.1 with the rule.
    {
      "includes": ["tests/**/*.{ts,tsx}"],
      "plugins": ["./biome-plugins/require-test-server-hostname.grit"]
    },
    // A test reads pg_stat_activity for its own database or backends only
    // (biome-plugins/no-unscoped-pg-stat-activity.grit). No file is listed: every read under tests/
    // was narrowed with the rule.
    {
      "includes": ["tests/**/*.{ts,tsx}"],
      "plugins": ["./biome-plugins/no-unscoped-pg-stat-activity.grit"]
    },
    {
      "includes": ["tests/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": "off"
          }
        }
      }
    }
  ]
}
