// The ledger of every bare text-cap-shaped `.slice(…)` left in src/, with how many each file holds
// and what each one is. The cap that keeps the head is `.slice(0, n)`, the one that keeps the tail
// `.slice(-n)` or `.slice(x.length - n)`; every other `.slice(…)` names a position the code computed.
// A bare cut can split an astral character in half (tests/lib/astral-cap-sweep.test.ts runs every
// real cap with one straddling the cut), and a regex cannot tell a string cut from an array bound, so
// a new one fails here until somebody writes down which it is: array (bounds how MANY entries are
// kept), index (a position the code computed), ascii (the value is ASCII by construction),
// fixed-format (a date or version string of known shape), parse-only (handed to a parser, never used
// as text), the-cut (`clipText` itself). A cap routed through `clipText` leaves no occurrence.
//
// Counted on the file's text the same way as pin-error-column-lines.grit, and each
// `slices_at_least_N` repeats the same occurrence N times.
language js;

pattern slices_at_least_1() { r"(?:(?:[\s\S]*?\n[ \t]*(?:[^ \t\n/*](?:[^\n/]|/[^/\n])*?|/[^/*\n](?:[^\n/]|/[^/\n])*?)?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-)|(?:[^\n/]|/[^/\n])*?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-))){1}[\s\S]*" }
pattern slices_at_least_2() { r"(?:(?:[\s\S]*?\n[ \t]*(?:[^ \t\n/*](?:[^\n/]|/[^/\n])*?|/[^/*\n](?:[^\n/]|/[^/\n])*?)?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-)|(?:[^\n/]|/[^/\n])*?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-))){2}[\s\S]*" }
pattern slices_at_least_3() { r"(?:(?:[\s\S]*?\n[ \t]*(?:[^ \t\n/*](?:[^\n/]|/[^/\n])*?|/[^/*\n](?:[^\n/]|/[^/\n])*?)?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-)|(?:[^\n/]|/[^/\n])*?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-))){3}[\s\S]*" }
pattern slices_at_least_4() { r"(?:(?:[\s\S]*?\n[ \t]*(?:[^ \t\n/*](?:[^\n/]|/[^/\n])*?|/[^/*\n](?:[^\n/]|/[^/\n])*?)?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-)|(?:[^\n/]|/[^/\n])*?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-))){4}[\s\S]*" }
pattern slices_at_least_5() { r"(?:(?:[\s\S]*?\n[ \t]*(?:[^ \t\n/*](?:[^\n/]|/[^/\n])*?|/[^/*\n](?:[^\n/]|/[^/\n])*?)?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-)|(?:[^\n/]|/[^/\n])*?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-))){5}[\s\S]*" }
pattern slices_at_least_6() { r"(?:(?:[\s\S]*?\n[ \t]*(?:[^ \t\n/*](?:[^\n/]|/[^/\n])*?|/[^/*\n](?:[^\n/]|/[^/\n])*?)?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-)|(?:[^\n/]|/[^/\n])*?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-))){6}[\s\S]*" }
pattern slices_at_least_7() { r"(?:(?:[\s\S]*?\n[ \t]*(?:[^ \t\n/*](?:[^\n/]|/[^/\n])*?|/[^/*\n](?:[^\n/]|/[^/\n])*?)?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-)|(?:[^\n/]|/[^/\n])*?\.slice\(\s*(?:0\s*,|-|[A-Za-z_$][\w$.]*\.length\s*-))){7}[\s\S]*" }

$program where {
    or {
        // ascii
        and { $filename <: r"(?:[\s\S]*/)?src/api/features/auth/auth\.service\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // ascii
        and { $filename <: r"(?:[\s\S]*/)?src/api/lib/auth\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // index
        and { $filename <: r"(?:[\s\S]*/)?src/api/middlewares/rateLimit\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/api/v1/document-approvals\.controller\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/client/components/Modal\.tsx", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // index
        and { $filename <: r"(?:[\s\S]*/)?src/client/contexts/ThemeContext\.tsx", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/client/lib/breadcrumbs\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // parse-only: The text BEFORE a parse error, counted and thrown away: the cut result is never shown, stored or sent. The offset comes from the JSON grammar, which reports token boundaries, so it cannot land inside a code point.
        and { $filename <: r"(?:[\s\S]*/)?src/client/lib/sampleJson\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // ascii: Four cuts into a DATE KEY: `YYYY-MM-DD` and the ten leading characters of an ISO instant. Every character on either side of every one of them is a digit or a hyphen, and `DATE_KEY_RE` refuses anything else before the value is used, so no cut here can land inside a surrogate pair.
        and { $filename <: r"(?:[\s\S]*/)?src/client/lib/auditPeriod\.ts", or { not $program <: slices_at_least_4(), $program <: slices_at_least_5() } },
        // array: The cursor stack's own pop (Previous), and the page's array of entries. The one cut that lands in TEXT (the preview of a `before`/`after` value, which can be a system prompt) goes through `clipText` like every other cap.
        and { $filename <: r"(?:[\s\S]*/)?src/client/pages/AuditPage\.tsx", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/client/pages/LogsPage\.tsx", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // index: The signature's own token insert, which splices at a SELECTION. A caret is a position the browser maintains and it never sits between the two halves of an astral character. The two cuts in that field that DO bound the value go through `clipText`.
        and { $filename <: r"(?:[\s\S]*/)?src/client/pages/agents/BehaviorTab\.tsx", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/client/pages/agents/CapabilityMap\.tsx", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/client/pages/agents/PlaygroundChat\.tsx", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // index
        and { $filename <: r"(?:[\s\S]*/)?src/client/pages/agents/PromptPanel\.tsx", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/client/pages/agents/followUpFormState\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/client/pages/agents/snoozedFollowUpFormState\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/client/pages/approvals/ConversationApprovals\.tsx", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // index: Two: the token insert splices at a SELECTION, which the browser never puts inside a surrogate pair, and `eachBlockEdit` cuts at the same boundary to ask what sits on either side of it.
        and { $filename <: r"(?:[\s\S]*/)?src/client/pages/resources/ToolEditModal\.tsx", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // array: The history without its last message, when that message is a stalled repeat the dangling-call repair leaves to the stall's own removal. An array of messages, never a string.
        and { $filename <: r"(?:[\s\S]*/)?src/graph/graph\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // ascii: The idempotency key's tail is a hex digest.
        and { $filename <: r"(?:[\s\S]*/)?src/graph/tools/documents\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // ascii
        and { $filename <: r"(?:[\s\S]*/)?src/graph/tools/mcp\.ts", or { not $program <: slices_at_least_5(), $program <: slices_at_least_6() } },
        // array: Six: the fifth is the ceiling on what the model is SHOWN of a scope's labels, applied to the write report, and the sixth is the same ceiling over the GUARDED list. Both cut arrays of label titles, so neither cut can land inside one.
        and { $filename <: r"(?:[\s\S]*/)?src/graph/tools/native\.ts", or { not $program <: slices_at_least_6(), $program <: slices_at_least_7() } },
        // array: The same ceiling at its source, over the same array of titles (graph/tools/label-view.ts).
        and { $filename <: r"(?:[\s\S]*/)?src/graph/tools/label-view\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // ascii
        and { $filename <: r"(?:[\s\S]*/)?src/graph/tools/toolName\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array + index
        and { $filename <: r"(?:[\s\S]*/)?src/graph/trace\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/lib/redact\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // index
        and { $filename <: r"(?:[\s\S]*/)?src/lib/ssrf\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // the-cut
        and { $filename <: r"(?:[\s\S]*/)?src/lib/text\.ts", or { not $program <: slices_at_least_3(), $program <: slices_at_least_4() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/agents/credential-paths\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/agents/text-caps\.ts", or { not $program <: slices_at_least_3(), $program <: slices_at_least_4() } },
        // array: Three, none bounding prose. `countNotStoredAsWritten` cuts the bundled entries a schedule cap lets through (an array of JSON entries). `renamedToolName` trims the STEM of a tool name, already `[a-z0-9_-]` from `normalizeToolName`, so the `_2` suffix fits the provider's 64. The third clamps an imported protected-label list, an array of titles. The label and description that loop clips go through `clipText`.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/agents/transfer\.ts", or { not $program <: slices_at_least_3(), $program <: slices_at_least_4() } },
        // ascii: The date the reminder says it was sent on, cut from `toISOString()`: a fixed-width ASCII `YYYY-MM-DD` the runtime produces, never operator or customer text.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/appointments/reminders\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // ascii
        and { $filename <: r"(?:[\s\S]*/)?src/modules/api-keys/verify\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/appointments/settings\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array + ascii: The page's own overshoot row, dropped: the list takes `limit + 1` to learn whether a next page exists, and it cuts an array of rows, never a string. The export's two, and neither touches a string: the page's overshoot row is dropped off an ARRAY of rows (`limit + 1`, to learn whether more matched), and the filename's instant is sliced off an ISO string, which is ASCII by construction. The byte budget cuts BETWEEN rows and never inside one, so the file cannot end on half a character either.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/audit/export\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // array: The page's overshoot row, dropped off an ARRAY (`limit + 1`, to learn whether more matched). The cursor codec splits on the separator it wrote rather than cutting at an offset.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/audit/service\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // fixed-format
        and { $filename <: r"(?:[\s\S]*/)?src/modules/business-hours/announce\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // fixed-format
        and { $filename <: r"(?:[\s\S]*/)?src/modules/business-hours/hours\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/chatwoot/attributes\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array: The drain's room for rows that failed here, cut off an ARRAY of row ids.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/chatwoot/delivery-queue\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array: NOTE: the first few offending account ids for the refusal message. A slice over an array of NUMBERS cannot land inside a surrogate pair; the join that renders it happens after the cut.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/chatwoot/management\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/conversations/service\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array: The newest turns' lines kept off an ARRAY of turns, never a string.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/conversations/usage\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array: Two: the newest `maxFiles` of the candidate files, and the newest entries of the carried record. Both are ARRAYS (of files, of `msg:attachment` entries), never a string.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/cross-inbox-case/carry-attachments\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // array: The operator's case labels capped as an ARRAY of labels, never a string.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/cross-inbox-case/settings\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/debounce/handler\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // array: The approval page's last messages: an array bound.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/documents/approval-context\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // ascii: The logo's one-shot download token is hex from randomUUID.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/documents/company\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // fixed-format + ascii: The legacy date fallback reads a fixed ISO prefix; the file name was already reduced to [a-zA-Z0-9-] before it is bounded, because it travels through a Content-Disposition header.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/documents/issue\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // fixed-format
        and { $filename <: r"(?:[\s\S]*/)?src/modules/documents/sample\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // ascii: The tool name a template derives to, after the name was reduced to [a-z0-9_]. This ledger is keyed by PATH, so moving a cut to another file reads as an unaccounted cut there.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/documents/slug\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // fixed-format + array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/flowlog/export\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/flowlog/read\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array: The reminder's window, the newest messages kept off an ARRAY of rows, twice: once to render, once to pick what to read.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/followups/snoozed\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // fixed-format: `parseIsoInstant`: the date half of an ISO instant, to check a calendar `Date.parse` would silently normalise (February 30 to March 2). Position 10 is the format's own boundary, and the string already matched an ASCII-only pattern.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/flowlog/settings\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/followups/settings\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/followups/snoozed-settings\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/images/fetch\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // fixed-format: No response-body cap here: `lib/outbound.ts` caps the READ, cutting through `clipText`.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/integrations/toolpacks/asaas\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array: The refusal a calendar write answers with lists the nearest bookable slots; the cut bounds that LIST, and each entry is a slot object this code built, never received text.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/integrations/toolpacks/calendar-slots\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // ascii: Zod issue PATHS, which name our own schema's keys, never the received values.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/integrations/mappers\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/mcp/write-agents\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // index + array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/memory/cut\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // array: Four: the transcript window, the notes window, the label-change window and the page walk. Every one is a slice of an ARRAY of rows, so none can land inside a surrogate pair.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/observe/job\.ts", or { not $program <: slices_at_least_4(), $program <: slices_at_least_5() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/playground/service\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array: The page of a document list: `rows.slice(0, take)` keeps the first `take` rows.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/rag/documents\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array: The balloon's own LINES, cut from the array `split("\n")` returned, to ask whether the run at either end of it is the model's copy of the signature. An array of strings, never a string, so no cut can land inside a code point; and the pieces are compared, never sent.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/signature/service\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // array: Two: the overflow merge carries the separators beside the chunks, and both are slices of an ARRAY of already-split strings, so neither can land inside a surrogate pair.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/split/service\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // ascii: The audit fingerprint of the over-ceiling sentence: a hex digest, so the cut cannot land inside a surrogate pair.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/tenant-settings/service\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/tool-definitions/body-shape\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array: Two. How many items the picker samples for a block's fields (entries, never characters; the per-value cut inside an item goes through clipText). And `templateWriteAt` cutting the document at the CARET to read what the operator typed since `{{`: CodeMirror never puts a caret inside a surrogate pair, and the result is parsed, never shown.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/tool-definitions/response-template\.ts", or { not $program <: slices_at_least_2(), $program <: slices_at_least_3() } },
        // array
        and { $filename <: r"(?:[\s\S]*/)?src/modules/updates/semver\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // parse-only: Read only to be substring-matched against the provider's auth-failure shapes, then dropped: never stored, never shown, never sent anywhere.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/vault/secret-test\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // array: The page's own overshoot row, dropped: the list takes `limit + 1` to learn whether a next page exists. Same shape as flowlog/read.ts, and it cuts an array of rows, never a string.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/webhooks/outbound/deliveries\.ts", or { not $program <: slices_at_least_1(), $program <: slices_at_least_2() } },
        // parse-only: not TypeScript cuts but three `.slice(0, …)` inside the JavaScript source this file hands QuickJS as a template literal, which the text count reads as code.
        and { $filename <: r"(?:[\s\S]*/)?src/graph/tools/code-sandbox\.worker\.ts", or { not $program <: slices_at_least_3(), $program <: slices_at_least_4() } },
        // Any other file names none.
