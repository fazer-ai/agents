// Refuses a no-op `onCloseRequest` on a JSX element (`() => {}`, `() => undefined`, alone or as a
// branch of a ternary). It was the documented way to block a modal's dismissal while a request is in
// flight, and it holds only while the form is clean: `<Modal>` opens the discard prompt on a dirty
// form before it ever calls `onCloseRequest`, so "Discard" closes the modal with the write still on
// its way. The way to say a request is in flight is `busy={…}`, which blocks every
// user-driven close and never opens the prompt. An `onCloseRequest` that does something (a
// confirmation of its own) is not touched.
language js;

JsxAttribute() as $attr where {
    $attr <: r"(?s)\s*onCloseRequest\s*=\s*\{.*\(\s*\)\s*=>\s*(?:\{\s*\}|undefined|void\s+0)(?:\s*[:}]).*",
    register_diagnostic(span = $attr, message = "A no-op `onCloseRequest` does not block a dirty modal's dismissal: the discard prompt runs first. Pass `busy={…}` to `<Modal>` while a request is in flight (docs/modals.md).")
}
