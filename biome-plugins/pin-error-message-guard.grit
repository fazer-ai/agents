// The ledger of every file under src/ that names `sanitizeErrorMessage(`, with how many times. It is
// the other half of pin-error-column-lines.grit, and the half that reaches the two columns that rule
// cannot count: `knowledge_documents.error` and `alert_deliveries.summary` are named by keys
// (`error`, `summary`) far too common to count. Pinning where the guard is CALLED reaches them, and
// a removed call fails here even where the column's own line reads as an ordinary `read`. A call in
// an unlisted file fails too: a new caller is a new site to list, with its reason.
//
// Counted on the file's text the same way as pin-error-column-lines.grit, and each `guards_at_least_N`
// repeats the same occurrence N times.
language js;

pattern guards_at_least_1() { r"(?:(?:[\s\S]*?\n[ \t]*(?:[^ \t\n/*](?:[^\n/]|/[^/\n])*?|/[^/*\n](?:[^\n/]|/[^/\n])*?)?sanitizeErrorMessage\(|(?:[^\n/]|/[^/\n])*?sanitizeErrorMessage\()){1}[\s\S]*" }
pattern guards_at_least_2() { r"(?:(?:[\s\S]*?\n[ \t]*(?:[^ \t\n/*](?:[^\n/]|/[^/\n])*?|/[^/*\n](?:[^\n/]|/[^/\n])*?)?sanitizeErrorMessage\(|(?:[^\n/]|/[^/\n])*?sanitizeErrorMessage\()){2}[\s\S]*" }
pattern guards_at_least_3() { r"(?:(?:[\s\S]*?\n[ \t]*(?:[^ \t\n/*](?:[^\n/]|/[^/\n])*?|/[^/*\n](?:[^\n/]|/[^/\n])*?)?sanitizeErrorMessage\(|(?:[^\n/]|/[^/\n])*?sanitizeErrorMessage\()){3}[\s\S]*" }
pattern guards_at_least_4() { r"(?:(?:[\s\S]*?\n[ \t]*(?:[^ \t\n/*](?:[^\n/]|/[^/\n])*?|/[^/*\n](?:[^\n/]|/[^/\n])*?)?sanitizeErrorMessage\(|(?:[^\n/]|/[^/\n])*?sanitizeErrorMessage\()){4}[\s\S]*" }

$program where {
    or {
        // The cause of a failed call, the cause of a thrown one, and the turn's outcome line per tool.
        and { $filename <: r"(?:[\s\S]*/)?src/graph/tool-flowlog\.ts", or { not $program <: guards_at_least_3(), $program <: guards_at_least_4() } },
        // The definition.
        and { $filename <: r"(?:[\s\S]*/)?src/lib/redact\.ts", or { not $program <: guards_at_least_1(), $program <: guards_at_least_2() } },
        and { $filename <: r"(?:[\s\S]*/)?src/modules/conversations/error\.ts", or { not $program <: guards_at_least_1(), $program <: guards_at_least_2() } },
        and { $filename <: r"(?:[\s\S]*/)?src/modules/conversations/failure-note\.ts", or { not $program <: guards_at_least_1(), $program <: guards_at_least_2() } },
        // The worker's send, shared with the console's Test button, sanitizes in its own `catch`; the worker writes `alert_deliveries.last_error` from the string this file built.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/flowlog/alert-send\.ts", or { not $program <: guards_at_least_1(), $program <: guards_at_least_2() } },
        // The body of an alert and of a rate alert, each a line posted to the channel.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/flowlog/alerts\.ts", or { not $program <: guards_at_least_2(), $program <: guards_at_least_3() } },
        and { $filename <: r"(?:[\s\S]*/)?src/modules/flowlog/service\.ts", or { not $program <: guards_at_least_2(), $program <: guards_at_least_3() } },
        and { $filename <: r"(?:[\s\S]*/)?src/modules/rag/documents\.ts", or { not $program <: guards_at_least_1(), $program <: guards_at_least_2() } },
        // A knowledge source run's failure (the fetch, the reconcile) before it reaches `last_message`, and the boot re-arm's before it reaches the log.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/rag/source\.ts", or { not $program <: guards_at_least_3(), $program <: guards_at_least_4() } },
        // The third reads it back: a run past its deadline takes its row back only while the row still carries the failure that deadline wrote, compared in the form `failJob` stored it.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/scheduler/service\.ts", or { not $program <: guards_at_least_3(), $program <: guards_at_least_4() } },
        // The ledger read's error text, before it reaches `poll_error`.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/spend-ceiling/poll\.ts", or { not $program <: guards_at_least_1(), $program <: guards_at_least_2() } },
        // The line the retry loop writes for a retry it announced and could not start.
        and { $filename <: r"(?:[\s\S]*/)?src/modules/vision/service\.ts", or { not $program <: guards_at_least_1(), $program <: guards_at_least_2() } },
        and { $filename <: r"(?:[\s\S]*/)?src/modules/webhooks/outbound/worker\.ts", or { not $program <: guards_at_least_1(), $program <: guards_at_least_2() } },
        // Any other file names none.
        and { not $filename <: or { r"(?:[\s\S]*/)?src/graph/tool-flowlog\.ts", r"(?:[\s\S]*/)?src/lib/redact\.ts", r"(?:[\s\S]*/)?src/modules/conversations/error\.ts", r"(?:[\s\S]*/)?src/modules/conversations/failure-note\.ts", r"(?:[\s\S]*/)?src/modules/flowlog/alert-send\.ts", r"(?:[\s\S]*/)?src/modules/flowlog/alerts\.ts", r"(?:[\s\S]*/)?src/modules/flowlog/service\.ts", r"(?:[\s\S]*/)?src/modules/rag/documents\.ts", r"(?:[\s\S]*/)?src/modules/rag/source\.ts", r"(?:[\s\S]*/)?src/modules/scheduler/service\.ts", r"(?:[\s\S]*/)?src/modules/spend-ceiling/poll\.ts", r"(?:[\s\S]*/)?src/modules/vision/service\.ts", r"(?:[\s\S]*/)?src/modules/webhooks/outbound/worker\.ts" }, $program <: guards_at_least_1() }
    },
    register_diagnostic(span = $program, message = "This file's count of `sanitizeErrorMessage(` is not the one biome-plugins/pin-error-message-guard.grit lists for it (none, for a file it does not list): a call was removed or added. Restore it, or change the count there with the reason.")
}
